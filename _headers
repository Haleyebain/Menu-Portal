# Keep the portal out of search engines and out of frames.
/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Storage and the door must never be cached.
/api/*
  Cache-Control: no-store

# HTML always revalidates, so a deploy shows up on the next load.
/*.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate

# Images and fonts revalidate on every load, so a redeploy shows up right away.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
# The PDF libraries never change.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
